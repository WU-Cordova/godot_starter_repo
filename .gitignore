builds/
exports/
*.exe
*.pck
*.zip
*.dmg
*.apk

# Export presets can embed signing credentials; add per-project if it is safe
export_presets.cfg

# --- Editors / OS noise ---
.DS_Store
Thumbs.db
*.tmp
*.bak
.vscode/
.idea/
